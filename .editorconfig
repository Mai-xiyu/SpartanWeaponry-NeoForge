root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4

[*.gradle]
indent_style = space
indent_size = 4

[*.{json,mcmeta,md,yml,yaml,toml,properties}]
indent_style = space
indent_size = 2

[gradle-wrapper.properties]
indent_style = space
indent_size = 4
